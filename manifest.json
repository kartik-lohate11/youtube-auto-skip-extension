{
  "manifest_version": 3,
  "name": "YouTube Auto Skip",
  "version": "1.0.0",
  "description": "Automatically skips eligible YouTube ad skip prompts.",
  "permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}